# Copy this file to .env and fill in real values. .env is git-ignored.

# Server
PORT=8080
INSTANCE_ID=backend-1            # unique per copy (the distributed proof)

# Database (local MySQL via Homebrew: root has no password by default)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=task_engine

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# Worker pool
WORKER_COUNT=8
HUNG_TASK_TIMEOUT_SECONDS=60
WATCHDOG_INTERVAL_SECONDS=15

# Rate limiting
RATE_LIMIT_PER_MINUTE=10

# Task simulation
TASK_FAILURE_RATE=0.2           # 20% of tasks randomly fail
